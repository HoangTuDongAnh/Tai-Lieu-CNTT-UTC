

@{
    var lang = (Context.Request.Query["lang"].FirstOrDefault() ?? ViewBag.Lang as string ?? "vi").ToLower();
    string T(string vi, string en) => lang == "en" ? en : vi;
}

<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasReportDetails" aria-labelledby="offcanvasReportDetailsLabel" style="width: 600px;">
    <div class="offcanvas-header border-bottom">
        <h5 id="offcanvasReportDetailsLabel" class="offcanvas-title">@T("Chi tiết hỗ trợ", "Support Details")</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>

    <div class="offcanvas-body mx-0 flex-grow-1 p-4">
        <div class="mb-4">
            <small class="text-primary fw-medium">#SUP-2026-0009</small>
            <h5 class="fw-bold mb-3 mt-1">Lỗi không lưu được giao dịch chi tiêu</h5>

            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <img src="~/sneat/img/avatars/1.png" alt="Avatar" class="rounded-circle me-2" width="32" />
                    <div>
                        <h6 class="mb-0">Hoang Mai</h6>
                        <small class="text-muted">30/03/2026 14:10</small>
                    </div>
                </div>
                <div class="text-end">
                    <span class="badge bg-label-danger d-block mb-1">Báo lỗi hệ thống</span>
                    <span class="badge bg-label-warning d-block">Ưu tiên: Cao</span>
                </div>
            </div>
        </div>

        <div class="mb-4">
            <h6 class="text-uppercase fw-semibold mb-2 text-xs">@T("Nội dung hỗ trợ", "Support Message")</h6>
            <div class="p-3 bg-lighter rounded border">
                <p class="mb-0 small text-dark">
                    Khi nhập số tiền và chọn danh mục, nút lưu không báo lỗi nhưng dữ liệu không xuất hiện trong danh sách giao dịch. Vui lòng xem video đính kèm để rõ hơn.
                </p>
            </div>
        </div>

        <div class="mb-4">
            <h6 class="text-uppercase fw-semibold mb-2 text-xs">@T("Tệp đính kèm (Click để phóng to)", "Attachments (Click to enlarge)")</h6>
            <div id="reportMediaCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel">
                <div class="carousel-indicators">
                    <button type="button" data-bs-target="#reportMediaCarousel" data-bs-slide-to="0" class="active"></button>
                    <button type="button" data-bs-target="#reportMediaCarousel" data-bs-slide-to="1"></button>
                    <button type="button" data-bs-target="#reportMediaCarousel" data-bs-slide-to="2"></button>
                </div>

                <div class="carousel-inner rounded shadow-sm border bg-black">
                    <div class="carousel-item active">
                        <img class="d-block w-100 cursor-pointer" src="~/sneat/img/elements/1.png" style="height: 250px; object-fit: cover;" onclick="openLightbox(0)" />
                    </div>
                    <div class="carousel-item">
                        <img class="d-block w-100 cursor-pointer" src="~/sneat/img/elements/2.png" style="height: 250px; object-fit: cover;" onclick="openLightbox(1)" />
                    </div>
                    <div class="carousel-item" data-bs-interval="false">
                        <div class="position-relative">
                            <video class="d-block w-100" style="height: 250px; object-fit: contain;">
                                <source src="https://www.w3schools.com/html/mov_bbb.mp4" type="video/mp4">
                            </video>
                            <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center cursor-pointer" style="background: rgba(0,0,0,0.3)" onclick="openLightbox(2)">
                                <i class="bx bx-play-circle text-white display-4"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <button class="carousel-control-prev" type="button" data-bs-target="#reportMediaCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#reportMediaCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                </button>
            </div>
        </div>
    </div>

    <div class="offcanvas-footer border-top p-4">
        <button type="button" class="btn btn-success d-grid w-100 mb-2">@T("Đánh dấu: Đã xử lý", "Mark as: Processed")</button>
        <button type="button" class="btn btn-outline-secondary d-grid w-100" data-bs-dismiss="offcanvas">@T("Đóng", "Close")</button>
    </div>
</div>


<div class="modal fade" id="mediaPopupModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-left-area">
        <div class="modal-content bg-transparent border-0 shadow-none" style="cursor: zoom-out;">
            <div class="modal-body p-0 d-flex justify-content-center">
                <div class="w-100" style="cursor: default;">

                    <div id="lightboxCarousel" class="carousel slide" data-bs-interval="false">
                        <div class="carousel-inner text-center">

                            <div class="carousel-item active">
                                <img src="~/sneat/img/elements/1.png" class="media-popup-item img-fluid rounded shadow-lg" />
                                <div class="carousel-caption d-none d-md-block" style="bottom: -40px;">
                                    <p class="text-white">screenshot-loi-giao-dich.png</p>
                                </div>
                            </div>

                            <div class="carousel-item">
                                <img src="~/sneat/img/elements/2.png" class="media-popup-item img-fluid rounded shadow-lg" />
                                <div class="carousel-caption d-none d-md-block" style="bottom: -40px;">
                                    <p class="text-white">console-log.png</p>
                                </div>
                            </div>

                            <div class="carousel-item">
                                <video id="lightboxVideo" controls class="media-popup-item w-100 rounded shadow-lg">
                                    <source src="https://www.w3schools.com/html/mov_bbb.mp4" type="video/mp4">
                                </video>
                                <div class="carousel-caption d-none d-md-block" style="bottom: -40px;">
                                    <p class="text-white">mo-ta-loi-khong-luu-duoc.mp4</p>
                                </div>
                            </div>
                        </div>

                        <button class="carousel-control-prev" type="button" data-bs-target="#lightboxCarousel" data-bs-slide="prev" style="width: 10%;">
                            <span class="carousel-control-prev-icon" aria-hidden="true" style="width: 3rem; height: 3rem;"></span>
                            <span class="visually-hidden">@T("Trước", "Previous")</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#lightboxCarousel" data-bs-slide="next" style="width: 10%;">
                            <span class="carousel-control-next-icon" aria-hidden="true" style="width: 3rem; height: 3rem;"></span>
                            <span class="visually-hidden">@T("Sau", "Next")</span>
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>



<script>
    let lightboxModalInstance;
    let videoElement;
    document.addEventListener("DOMContentLoaded", function() {
        const modalElement = document.getElementById('mediaPopupModal');
        videoElement = document.getElementById('lightboxVideo');

        lightboxModalInstance = new bootstrap.Modal(modalElement);
        new bootstrap.Carousel(document.getElementById('lightboxCarousel'), { interval: false });

        modalElement.addEventListener('hidden.bs.modal', function () {
            if(videoElement) videoElement.pause();
        });

        document.getElementById('lightboxCarousel').addEventListener('slide.bs.carousel', function () {
            if(videoElement) videoElement.pause();
        });

        modalElement.addEventListener('click', function (e) {
            const isMediaTarget = e.target.tagName === 'IMG' || e.target.tagName === 'VIDEO';
            const isBtnTarget = e.target.closest('.carousel-control-prev') || e.target.closest('.carousel-control-next');

            if (!isMediaTarget && !isBtnTarget) {
                lightboxModalInstance.hide();
            }
        });
    });
    function openLightbox(slideIndex) {
        const slides = document.querySelectorAll('#lightboxCarousel .carousel-item');
        slides.forEach(slide => slide.classList.remove('active'));
        slides[slideIndex].classList.add('active');

        lightboxModalInstance.show();
        if (slideIndex === 2) {
            setTimeout(() => {
                if(videoElement) videoElement.play();
            }, 350);
        }
    }
</script>