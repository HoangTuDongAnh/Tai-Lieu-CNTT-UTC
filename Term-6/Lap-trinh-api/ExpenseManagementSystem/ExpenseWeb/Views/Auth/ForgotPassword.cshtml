@model ExpenseWeb.Models.ViewModels.Auth.ForgotPasswordViewModel

@{
    var lang = (Context.Request.Query["lang"].FirstOrDefault() ?? "vi").ToLower();
    if (lang != "en") lang = "vi";
    string T(string vi, string en) => lang == "en" ? en : vi;

    ViewBag.Title = T("Quên mật khẩu", "Forgot Password");
    ViewBag.AuthPageClass = "auth-page--single";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";

    string SwitchLangUrl(string targetLang)
    {
        return Url.Action("ForgotPassword", "Auth", new { lang = targetLang }) ?? "#";
    }
}

<div class="auth-page">
    <div class="auth-toast-stack" id="authToastStack"></div>

    <div class="auth-forgot-shell">
        <div class="auth-single-mobile-topbar">
            <a href="@Url.Action("Login", "Auth", new { lang = lang })" class="auth-single-mobile-brand">
                <span class="auth-brand-mark auth-brand-mark-letter">M</span>
                <span>Mimo</span>
            </a>

            <div class="auth-language">
                <a href="@SwitchLangUrl("vi")" class="@(lang == "vi" ? "active" : "")">VI</a>
                <a href="@SwitchLangUrl("en")" class="@(lang == "en" ? "active" : "")">EN</a>
            </div>
        </div>

        <div class="auth-single-mobile-hero">
            <h3>@T("Khôi phục mật khẩu", "Recover your password")</h3>
            <p>@T("Nhập email đã đăng ký để nhận hướng dẫn đặt lại mật khẩu.", "Enter your registered email to receive reset instructions.")</p>
        </div>

        <section class="auth-forgot-hero">
            <div class="auth-hero-art">
                <span class="auth-shape shape-1"></span>
                <span class="auth-shape shape-2"></span>
                <span class="auth-shape shape-3"></span>
                <span class="auth-line line-1"></span>
                <span class="auth-line line-2"></span>
                <span class="auth-line line-3"></span>
            </div>

            <div class="auth-language">
                <a href="@SwitchLangUrl("vi")" class="@(lang == "vi" ? "active" : "")">VI</a>
                <a href="@SwitchLangUrl("en")" class="@(lang == "en" ? "active" : "")">EN</a>
            </div>

            <a href="@Url.Action("Login", "Auth", new { lang = lang })" class="auth-brand">
                <span class="auth-brand-mark auth-brand-mark-letter">M</span>
                <span>Mimo</span>
            </a>

            <div class="auth-overlay-content">
                <div class="auth-badge">
                    <i class="bx bx-key"></i>
                    <span>@T("Khôi phục truy cập", "Recover access")</span>
                </div>

                <h1>@T("Khôi phục mật khẩu", "Recover your password")</h1>
                <p>
                    @T(
                    "Nhập email đã đăng ký, hệ thống sẽ gửi hướng dẫn để bạn đặt lại mật khẩu và quay lại quản lý chi tiêu nhanh chóng.",
                                        "Enter your registered email and the system will send instructions so you can reset your password and get back to managing your finances."
                                        )
                </p>

                <div class="auth-hero-points">
                    <div class="auth-hero-point">
                        <i class="bx bx-envelope-open"></i>
                        <span>@T("Gửi hướng dẫn đặt lại qua email", "Send reset instructions by email")</span>
                    </div>
                    <div class="auth-hero-point">
                        <i class="bx bx-check-shield"></i>
                        <span>@T("Khôi phục truy cập an toàn", "Recover access securely")</span>
                    </div>
                </div>
            </div>
        </section>

        <section class="auth-forgot-panel">
            <div class="auth-form-wrap">
                <div class="auth-eyebrow">@T("Quên mật khẩu", "Forgot password")</div>
                <h2>@T("Lấy lại quyền truy cập", "Get access back")</h2>
                <p class="auth-form-subtitle">
                    @T(
                                        "Nhập email của bạn để nhận hướng dẫn đặt lại mật khẩu.",
                                        "Enter your email to receive password reset instructions."
                                        )
                </p>

                <form asp-action="ForgotPassword"
                      asp-controller="Auth"
                      method="post"
                      class="auth-card-form"
                      data-auth-form="forgot-password">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="lang" value="@lang" />

                    <div class="auth-field">
                        <label asp-for="Email">@T("Email", "Email")</label>
                        <div class="auth-input-wrap">
                            <i class="bx bx-envelope auth-input-icon"></i>
                            <input asp-for="Email"
                                   class="auth-input"
                                   placeholder="@T("Nhập email đã đăng ký", "Enter your registered email")"
                                   autocomplete="email"
                                   autofocus />
                        </div>
                    </div>

                    <button type="submit"
                            class="auth-submit"
                            data-submit-text
                            data-loading-text="@T("Đang gửi yêu cầu...", "Sending request...")">
                        @T("Gửi liên kết đặt lại", "Send reset link")
                    </button>
                </form>

                <div class="text-center mt-3">
                    <a href="@Url.Action("Login", "Auth", new { lang = lang })" class="auth-back-link">
                        <i class="bx bx-chevron-left"></i>
                        <span>@T("Quay lại đăng nhập", "Back to login")</span>
                    </a>
                </div>

                <div class="auth-footer-note">
                    <strong>Mimo</strong> —
                    @T("Khôi phục tài khoản một cách an toàn", "Recover your account safely")
                </div>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            @if (!ViewData.ModelState.IsValid)
            {
                var errors = ViewData.ModelState.Values
                    .SelectMany(v => v.Errors)
                    .Select(e => e.ErrorMessage)
                    .Where(x => !string.IsNullOrWhiteSpace(x))
                    .Distinct()
                    .ToList();

                if (errors.Count > 0)
                {
                    <text>
                    window.AuthToast?.error(window.AuthPage?.t("error"), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(errors)));
                    </text>
                }
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <text>
                window.AuthToast?.error(window.AuthPage?.t("error"), ["@TempData["ErrorMessage"]"]);
                </text>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <text>
                window.AuthToast?.success(window.AuthPage?.t("success"), ["@TempData["SuccessMessage"]"]);
                </text>
            }
        })();
    </script>
}
