@{
    var lang = (Context.Request.Query["lang"].FirstOrDefault() ?? "vi").ToLower();
    if (lang != "en") lang = "vi";
    string T(string vi, string en) => lang == "en" ? en : vi;

    ViewBag.Title = T("Xác nhận gửi email", "Email Sent");
    ViewBag.AuthPageClass = "auth-page--single";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-page">
    <div class="auth-toast-stack" id="authToastStack"></div>
    <div class="auth-forgot-shell">
        <section class="auth-forgot-hero">
            <div class="auth-hero-art">
                <span class="auth-shape shape-1"></span>
                <span class="auth-shape shape-2"></span>
                <span class="auth-shape shape-3"></span>
                <span class="auth-line line-1"></span>
                <span class="auth-line line-2"></span>
                <span class="auth-line line-3"></span>
            </div>

            <a href="@Url.Action("Login", "Auth", new { lang = lang })" class="auth-brand">
                <span class="auth-brand-mark auth-brand-mark-letter">M</span>
                <span>Mimo</span>
            </a>

            <div class="auth-overlay-content">
                <div class="auth-badge">
                    <i class="bx bx-check-circle"></i>
                    <span>@T("Yêu cầu đã được gửi", "Request sent")</span>
                </div>

                <h1>@T("Kiểm tra hộp thư của bạn", "Check your inbox")</h1>
                <p>
                    @T(
                    "Chúng tôi đã gửi hướng dẫn đặt lại mật khẩu đến email của bạn. Hãy kiểm tra hộp thư đến hoặc thư rác.",
                                        "We have sent password reset instructions to your email. Please check your inbox or spam folder."
                                        )
                </p>
            </div>
        </section>

        <section class="auth-forgot-panel">
            <div class="auth-form-wrap text-center">
                <div class="auth-eyebrow">@T("Hoàn tất bước đầu", "First step completed")</div>
                <h2>@T("Email đã được gửi", "Email sent")</h2>
                <p class="auth-form-subtitle">
                    @T(
                                        "Nếu email tồn tại trong hệ thống, bạn sẽ nhận được hướng dẫn đặt lại mật khẩu trong ít phút.",
                                        "If the email exists in the system, you will receive password reset instructions shortly."
                                        )
                </p>

                <a href="@Url.Action("Login", "Auth", new { lang = lang })" class="auth-submit d-inline-flex align-items-center justify-content-center text-decoration-none">
                    @T("Quay lại đăng nhập", "Back to login")
                </a>

                <div class="auth-footer-note">
                    <strong>Mimo</strong> —
                    @T("Theo dõi chi tiêu đơn giản và trực quan", "Simple and visual expense tracking")
                </div>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            @if (TempData["SuccessMessage"] != null)
            {
                <text>
                window.AuthToast?.success(window.AuthPage?.t("success"), ["@TempData["SuccessMessage"]"]);
                </text>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <text>
                window.AuthToast?.error(window.AuthPage?.t("error"), ["@TempData["ErrorMessage"]"]);
                </text>
            }
        })();
    </script>
}
