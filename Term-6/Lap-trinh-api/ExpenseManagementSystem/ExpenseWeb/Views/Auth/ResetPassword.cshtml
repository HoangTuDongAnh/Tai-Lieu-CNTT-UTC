@model ExpenseWeb.Models.ViewModels.Auth.ResetPasswordViewModel

@{
    var lang = (Context.Request.Query["lang"].FirstOrDefault() ?? "vi").ToLower();
    if (lang != "en") lang = "vi";
    string T(string vi, string en) => lang == "en" ? en : vi;

    ViewBag.Title = T("Đặt lại mật khẩu", "Reset Password");
    ViewBag.AuthPageClass = "auth-page--single";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";

    string SwitchLangUrl(string targetLang)
    {
        return Url.Action("ResetPassword", "Auth", new { token = Model.Token, lang = targetLang }) ?? "#";
    }
}

<div class="auth-page">
    <div class="auth-toast-stack" id="authToastStack"></div>

    <div class="auth-forgot-shell">
        <div class="auth-single-mobile-topbar">
            <a href="@Url.Action("Login", "Auth", new { lang = lang })" class="auth-single-mobile-brand">
                <span class="auth-brand-mark auth-brand-mark-letter">M</span>
                <span>Mimo</span>
            </a>

            <div class="auth-language">
                <a href="@SwitchLangUrl("vi")" class="@(lang == "vi" ? "active" : "")">VI</a>
                <a href="@SwitchLangUrl("en")" class="@(lang == "en" ? "active" : "")">EN</a>
            </div>
        </div>

        <div class="auth-single-mobile-hero">
            <h3>@T("Đặt lại mật khẩu", "Reset your password")</h3>
            <p>@T("Tạo mật khẩu mới để tiếp tục sử dụng hệ thống.", "Create a new password to continue using the system.")</p>
        </div>

        <section class="auth-forgot-hero">
            <div class="auth-hero-art">
                <span class="auth-shape shape-1"></span>
                <span class="auth-shape shape-2"></span>
                <span class="auth-shape shape-3"></span>
                <span class="auth-line line-1"></span>
                <span class="auth-line line-2"></span>
                <span class="auth-line line-3"></span>
            </div>

            <div class="auth-language">
                <a href="@SwitchLangUrl("vi")" class="@(lang == "vi" ? "active" : "")">VI</a>
                <a href="@SwitchLangUrl("en")" class="@(lang == "en" ? "active" : "")">EN</a>
            </div>

            <a href="@Url.Action("Login", "Auth", new { lang = lang })" class="auth-brand">
                <span class="auth-brand-mark auth-brand-mark-letter">M</span>
                <span>Mimo</span>
            </a>

            <div class="auth-overlay-content">
                <div class="auth-badge">
                    <i class="bx bx-lock-open-alt"></i>
                    <span>@T("Mật khẩu mới", "New password")</span>
                </div>

                <h1>@T("Đặt lại mật khẩu", "Reset your password")</h1>
                <p>
                    @T(
                    "Tạo mật khẩu mới để tiếp tục sử dụng hệ thống. Hãy chọn mật khẩu đủ mạnh và dễ nhớ với bạn.",
                                        "Create a new password to continue using the system. Choose a strong password that is still easy for you to remember."
                                        )
                </p>
            </div>
        </section>

        <section class="auth-forgot-panel">
            <div class="auth-form-wrap">
                <div class="auth-eyebrow">@T("Đặt lại mật khẩu", "Reset password")</div>
                <h2>@T("Tạo mật khẩu mới", "Create a new password")</h2>
                <p class="auth-form-subtitle">
                    @T(
                                        "Nhập mật khẩu mới và xác nhận để hoàn tất quá trình đặt lại mật khẩu.",
                                        "Enter and confirm your new password to complete the reset process."
                                        )
                </p>

                <form asp-action="ResetPassword"
                      asp-controller="Auth"
                      method="post"
                      class="auth-card-form"
                      data-auth-form="reset-password">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="lang" value="@lang" />
                    <input asp-for="Token" type="hidden" />

                    <div class="auth-field">
                        <label asp-for="NewPassword">@T("Mật khẩu mới", "New password")</label>
                        <div class="auth-input-wrap">
                            <i class="bx bx-lock-alt auth-input-icon"></i>
                            <input asp-for="NewPassword"
                                   id="newPassword"
                                   type="password"
                                   class="auth-input-password"
                                   placeholder="••••••••••••"
                                   autocomplete="new-password" />
                            <button type="button"
                                    class="auth-password-toggle"
                                    data-password-toggle="newPassword"
                                    tabindex="-1">
                                <i class="bx bx-hide"></i>
                            </button>
                        </div>
                    </div>

                    <div class="auth-field">
                        <label asp-for="ConfirmPassword">@T("Nhập lại mật khẩu", "Confirm password")</label>
                        <div class="auth-input-wrap">
                            <i class="bx bx-lock-alt auth-input-icon"></i>
                            <input asp-for="ConfirmPassword"
                                   id="confirmNewPassword"
                                   type="password"
                                   class="auth-input-password"
                                   placeholder="••••••••••••"
                                   autocomplete="new-password" />
                            <button type="button"
                                    class="auth-password-toggle"
                                    data-password-toggle="confirmNewPassword"
                                    tabindex="-1">
                                <i class="bx bx-hide"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit"
                            class="auth-submit"
                            data-submit-text
                            data-loading-text="@T("Đang cập nhật...", "Updating...")">
                        @T("Cập nhật mật khẩu", "Update password")
                    </button>
                </form>

                <div class="text-center mt-3">
                    <a href="@Url.Action("Login", "Auth", new { lang = lang })" class="auth-back-link">
                        <i class="bx bx-chevron-left"></i>
                        <span>@T("Quay lại đăng nhập", "Back to login")</span>
                    </a>
                </div>

                <div class="auth-footer-note">
                    <strong>Mimo</strong> —
                    @T("Giữ an toàn cho tài khoản của bạn", "Keep your account secure")
                </div>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            @if (!ViewData.ModelState.IsValid)
            {
                var errors = ViewData.ModelState.Values
                    .SelectMany(v => v.Errors)
                    .Select(e => e.ErrorMessage)
                    .Where(x => !string.IsNullOrWhiteSpace(x))
                    .Distinct()
                    .ToList();

                if (errors.Count > 0)
                {
                    <text>
                    window.AuthToast?.error(window.AuthPage?.t("error"), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(errors)));
                    </text>
                }
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <text>
                window.AuthToast?.success(window.AuthPage?.t("success"), ["@TempData["SuccessMessage"]"]);
                </text>
            }
        })();
    </script>
}
