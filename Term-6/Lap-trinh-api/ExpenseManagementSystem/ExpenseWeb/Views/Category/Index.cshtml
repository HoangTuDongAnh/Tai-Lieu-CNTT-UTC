                           data-default-en="This is a system default category. You can review its information and monitor the priority budget shown for it."
                           data-custom-vi="Đây là danh mục do bạn tạo. Bạn có thể chỉnh sửa thông tin và theo dõi toàn bộ hạn mức của danh mục này."
                           data-custom-en="This is a category created by you. You can edit its information and review all budgets belonging to it.">@T("Đây là danh mục mặc định của hệ thống. Bạn có thể xem thông tin và theo dõi hạn mức ưu tiên của danh mục này.", "This is a system default category. You can review its information and monitor the priority budget shown for it.")</p>
                        <span id="detailCategoryId" class="d-none"></span>
                    </div>
                </div>
                
            </div>

            <div class="modal-body category-detail-redesign__body mimo-popup-body">
                <input type="hidden" id="detailCategoryCanEdit" value="true" />
                <input type="hidden" id="detailCategoryCanDelete" value="true" />

                <div class="row g-4 category-detail-layout">
                    <div class="col-12 col-xl-5 category-detail-col">
                        <div class="category-stack-card category-stack-card--left">
                            <div class="category-section-card category-section-card--compact">
                                <div class="category-section-title mb-3">
                                    <i class="bx bx-edit"></i>
                                    <span>@T("Thông tin cơ bản", "Basic information")</span>
                                </div>

                                <div class="row g-3">
                                    <div class="col-12">
                                        <label class="form-label">@T("Tên danh mục", "Category name")</label>
                                        <input type="text" id="detailCategoryName" class="form-control category-field-input" />
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label">@T("Loại danh mục", "Category type")</label>
                                        <div class="category-type-toggle category-type-toggle--field" role="tablist" aria-label="@T("Category type", "Category type")">
                                            <button type="button" class="active" data-category-type-target="detail" data-category-type-value="expense">@T("Chi tiêu", "Expense")</button>
                                            <button type="button" data-category-type-target="detail" data-category-type-value="income">@T("Thu nhập", "Income")</button>
                                        </div>
                                        <input type="hidden" id="detailCategoryType" value="expense" />
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label">@T("Màu sắc", "Color")</label>
                                        <div class="category-color-toolbar category-color-toolbar--stack">
                                            <div class="category-color-presets category-color-presets--inline d-flex gap-2 flex-wrap">
                                                @foreach (var color in presetColors)
                                                {
                                                    <button type="button" class="category-color-preset-detail @(color == "#FFAB00" ? "active" : "")" data-color="@color" style="background:@color;"></button>
                                                }
                                            </div>

                                            <label class="category-color-custom-pill mt-2">
                                                <span>@T("Tùy chỉnh", "Custom")</span>
                                                <input type="color" id="detailCategoryColor" class="form-control form-control-color" value="#FFAB00" />
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="category-section-card category-section-card--compact category-section-card--fill">
                                <div class="category-section-title mb-2">
                                    <i class="bx bx-smile"></i>
                                    <span>@T("Biểu tượng", "Icon")</span>
                                </div>

                                <div class="icon-scroll-box category-icon-picker--tall">
                                    <div class="category-icon-group-list">
                                        @if (groupedIcons.Any())
                                        {
                                            var renderedIndex = 0;
                                            foreach (var group in groupedIcons)
                                            {
                                                <div class="category-icon-group-block">
                                                    <div class="category-icon-group-head">
                                                        <div>
                                                            <div class="category-icon-group-title">@group.Title</div>
                                                            <div class="category-icon-group-desc">@group.Description</div>
                                                        </div>
                                                        <span class="badge bg-label-secondary">@group.Icons.Count</span>
                                                    </div>

                                                    <div class="category-icon-picker category-icon-picker-grid">
                                                        @foreach (var fileName in group.Icons)
                                                        {
                                                            var iconUrl = $"/sneat/img/icons/categories/{fileName}";
                                                            <button type="button" class="category-icon-option category-icon-option-detail btn btn-outline-secondary p-2 @(renderedIndex == 0 ? "active" : "")" data-icon="@iconUrl" title="@iconDisplayName(fileName)">
                                                                <img src="@iconUrl" alt="@fileName" />
                                                            </button>
                                                            renderedIndex++;
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>

                                <input type="hidden" id="detailCategoryIcon" value="" />
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-xl-7 category-detail-col">
                        <div class="category-stack-card category-stack-card--right">
                            <div class="category-section-card category-section-card--compact category-section-card--fill category-budget-panel">
                                <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-3">
                                    <div>
                                        <div class="category-section-title mb-1">
                                            <i class="bx bx-wallet"></i>
                                            <span>@T("Hạn mức chi tiêu", "Budgets")</span>
                                        </div>
                                        <div class="text-muted small">@T("Hiển thị toàn bộ hạn mức của danh mục này.", "Shows every budget of this category.")</div>
                                    </div>

                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <span class="badge bg-label-info" id="budgetModalListCount">0 @T("mục", "items")</span>
                                        <button type="button" class="btn btn-sm btn-primary" id="btnOpenBudgetEditor">
                                            <i class="bx bx-plus me-1"></i>@T("Thêm hạn mức", "Add budget")
                                        </button>
                                    </div>
                                </div>

                                <div id="incomeBudgetLockedState" class="category-budget-empty category-budget-empty--locked d-none">
                                    <div class="category-budget-empty__icon"><i class="bx bx-trending-up"></i></div>
                                    <div class="category-budget-empty__title">@T("Danh mục thu nhập không có hạn mức", "Income categories do not use budgets")</div>
                                    <p class="category-budget-empty__text">@T("Hạn mức chỉ áp dụng cho danh mục chi tiêu. Bạn vẫn có thể đổi loại danh mục ở khung bên trái.", "Budgets are only available for expense categories. You can still change the category type on the left.")</p>
                                </div>

                                <div id="noBudgetState" class="category-budget-empty category-budget-empty--locked d-none">
                                    <div class="category-budget-empty__icon"><i class="bx bx-wallet"></i></div>
                                    <div class="category-budget-empty__title">@T("Chưa có hạn mức", "No budgets yet")</div>
                                    <p class="category-budget-empty__text">@T("Tạo hạn mức theo tuần, tháng hoặc năm.", "Create weekly, monthly, or yearly budgets.")</p>
                                </div>

                                <div id="hasBudgetState" class="d-none category-budget-state-fill">
                                    <div class="category-budget-collection-head mb-3">
                                        <div class="category-inline-budget-list__label">@T("Toàn bộ hạn mức hiện có", "All existing budgets")</div>
                                        <span class="category-budget-collection-note">@T("Danh sách được sắp theo trạng thái thời gian.", "Sorted by time status.")</span>
                                    </div>

                                    <div id="detailBudgetList" class="category-budget-grid"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div id="budgetChildOverlay" class="category-subdialog d-none" aria-hidden="true">
                <div class="category-subdialog__backdrop" data-budget-overlay-close="true"></div>

                <div class="category-subdialog__panel">
                    <div class="category-subdialog__header">
                        <div>
                            <div class="category-section-title mb-1">
                                <i class="bx bx-edit-alt"></i>
                                <span>@T("Thiết lập hạn mức", "Budget editor")</span>
                            </div>
                            <div class="text-muted small">@T("Thiết lập tạm thời hạn mức cho danh mục này. Chỉ khi bấm Lưu thay đổi ở popup chi tiết thì dữ liệu mới được lưu vào hệ thống.", "Set a temporary budget draft for this category. It will only be saved after you confirm Save changes in the category detail popup.")</div>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-label-primary" id="budgetModalModeBadge">@T("Tạo mới", "Create new")</span>
                            <button type="button" class="btn category-subdialog__close" id="btnCloseBudgetChild">&times;</button>
                        </div>
                    </div>

                    <div class="category-subdialog__body">
                        <input type="hidden" id="budgetModalBudgetId" value="" />

                        <div class="category-budget-editor-context mb-3">
                            <span class="category-mini-dot" id="budgetCurrentColorDot"></span>
                            <strong id="budgetCurrentCategoryText">@T("Danh mục", "Category")</strong>
                        </div>

                        <div class="category-budget-quick-range mb-3">
                            <button type="button" class="btn btn-sm btn-label-primary" data-budget-shortcut="current-week">@T("Tuần này", "This week")</button>
                            <button type="button" class="btn btn-sm btn-label-primary" data-budget-shortcut="current-month">@T("Tháng này", "This month")</button>
                            <button type="button" class="btn btn-sm btn-label-primary" data-budget-shortcut="current-year">@T("Năm nay", "This year")</button>
                            <button type="button" class="btn btn-sm btn-label-secondary" data-budget-shortcut="next-month">@T("Tháng sau", "Next month")</button>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">@T("Kỳ hạn", "Period type")</label>
                                <select id="budgetModalTimeType" class="form-select">
                                    <option value="week">@T("Theo tuần", "Weekly")</option>
                                    <option value="month" selected>@T("Theo tháng", "Monthly")</option>
                                    <option value="year">@T("Theo năm", "Yearly")</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">@T("Năm", "Year")</label>
                                <select id="budgetModalYear" class="form-select">
                                    @for (var y = DateTime.Now.Year - 2; y <= DateTime.Now.Year + 5; y++)
                                    {
                                        <option value="@y" selected="@(y == DateTime.Now.Year ? "selected" : null)">@y</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-4" id="budgetMonthWrap">
                                <label class="form-label">@T("Tháng", "Month")</label>
                                <select id="budgetModalMonth" class="form-select">
                                    @for (var monthOpt = 1; monthOpt <= 12; monthOpt++)
                                    {
                                        <option value="@monthOpt">@monthOpt</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-4 d-none" id="budgetWeekWrap">
                                <label class="form-label">@T("Tuần", "Week")</label>
                                <input type="date" id="budgetModalWeekDate" class="form-control" />
                                <select id="budgetModalWeek" class="form-select d-none">
                                    @for (var weekOpt = 1; weekOpt <= 53; weekOpt++)
                                    {
                                        <option value="@weekOpt">@weekOpt</option>
                                    }
                                </select>
                            </div>

                            <div class="col-12">
                                <div class="category-period-preview mb-0">
                                    <div class="category-period-preview__head">
                                        <div>
                                            <span>@T("Khoảng thời gian áp dụng", "Applied date range")</span>
                                            <div class="text-muted small mt-1" id="budgetModalPeriodHint">@T("Tự động theo kỳ hạn đang chọn.", "Calculated automatically from the selected period.")</div>
                                        </div>
                                        <span id="budgetModalPeriodLabel" class="badge bg-label-secondary">@T("Theo tháng", "Monthly")</span>
                                    </div>

                                    <div class="row g-3 mt-0">
                                        <div class="col-sm-6">
                                            <div class="category-period-preview__item">
                                                <span class="category-period-preview__label">@T("Bắt đầu", "Start")</span>
                                                <strong id="budgetModalStartDate">--/--/----</strong>
                                            </div>
                                        </div>
                                        <div class="col-sm-6">
                                            <div class="category-period-preview__item">
                                                <span class="category-period-preview__label">@T("Kết thúc", "End")</span>
                                                <strong id="budgetModalEndDate">--/--/----</strong>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-7">
                                <label class="form-label">@T("Ngân sách dự kiến (VNĐ)", "Budget amount (VND)")</label>
                                <input type="number" id="budgetModalAmount" class="form-control form-control-lg" placeholder="Ví dụ: 5000000" />
                            </div>
                            <div class="col-md-5">
                                <label class="form-label">@T("Đã chi trong kỳ", "Spent in period")</label>
                                <input type="text" id="budgetModalSpent" class="form-control form-control-lg bg-lighter" value="0 đ" readonly />
                            </div>
                        </div>
                    </div>

                    <div class="category-subdialog__footer">
                        <button type="button" class="btn btn-outline-secondary" id="btnCreateNewBudgetEntry">
                            <i class="bx bx-reset me-1"></i>@T("Đặt lại theo hiện tại", "Reset to current")
                        </button>
                        <button type="button" class="btn btn-primary" id="btnSaveBudget">
                            <i class="bx bx-save me-1"></i>@T("Lưu hạn mức", "Save budget")
                        </button>
                    </div>
                </div>
            </div>

<div id="deleteChildOverlay" class="category-subdialog category-delete-subdialog d-none" aria-hidden="true">
                <div class="category-subdialog__backdrop" data-delete-overlay-close="true"></div>

                <div class="category-subdialog__panel category-delete-subdialog__panel">
                    <div class="category-subdialog__header category-delete-subdialog__header">
                        <div>
                            <div class="category-section-title mb-1">
                                <i class="bx bx-trash"></i>
                                <span>@T("Xóa danh mục", "Delete category")</span>
                            </div>
                            <div class="text-muted small">@T("Chọn cách chuyển các giao dịch trước khi xóa danh mục này.", "Choose how to reassign transactions before deleting this category.")</div>
                        </div>

                        <button type="button" class="btn category-subdialog__close" id="btnCloseDeleteChild">&times;</button>
                    </div>

                    <div class="category-subdialog__body">
                        <div class="category-delete-summary-card mb-3">
                            <div class="category-delete-summary-card__icon"><i class="bx bx-folder-minus"></i></div>
                            <div class="category-delete-summary-card__content">
                                <div class="category-delete-summary-card__title" id="deleteCategoryNameText">@T("Danh mục", "Category")</div>
                                <div class="category-delete-summary-card__meta"><strong id="deleteCategoryTransactionCount">0</strong> @T("giao dịch sẽ được chuyển sang danh mục khác.", "transactions will be moved to another category.")</div>
                                <div class="category-delete-summary-card__note">@T("Các hạn mức của danh mục này sẽ bị xóa cùng lúc.", "Budgets of this category will be deleted as well.")</div>
                            </div>
                        </div>

                        <div class="category-delete-choice-grid">
                            <label class="category-delete-choice-card active" data-delete-choice-card="default" for="deleteModeDefault">
                                <input class="form-check-input" type="radio" name="deleteCategoryMode" id="deleteModeDefault" value="default" checked>
                                <div class="category-delete-choice-card__top">
                                    <span class="category-delete-choice-card__title">@T("Chuyển về “Khác”", "Move to “Other”")</span>
                                    <span class="badge bg-label-success">@T("Mặc định", "Default")</span>
                                </div>
                                <div class="category-delete-choice-card__desc">@T("Tất cả giao dịch sẽ được chuyển sang danh mục mặc định “Khác”.", "All transactions will be reassigned to the default “Other” category.")</div>
                            </label>

                            <label class="category-delete-choice-card" data-delete-choice-card="replacement" for="deleteModeReplacement">
                                <input class="form-check-input" type="radio" name="deleteCategoryMode" id="deleteModeReplacement" value="replacement">
                                <div class="category-delete-choice-card__top">
                                    <span class="category-delete-choice-card__title">@T("Chuyển sang danh mục khác", "Move to another category")</span>
                                    <span class="badge bg-label-primary">@T("Tùy chọn", "Custom")</span>
                                </div>
                                <div class="category-delete-choice-card__desc">@T("Chọn một danh mục thay thế từ danh sách để giữ giao dịch liên quan.", "Choose a replacement category from the list to keep related transactions organized.")</div>

                                <div class="category-delete-choice-card__field mt-3">
                                    <label class="form-label mb-2">@T("Danh mục thay thế", "Replacement category")</label>
                                    <select id="deleteReplacementCategoryId" class="form-select" disabled>
                                        <option value="">@T("-- Chọn danh mục thay thế --", "-- Select replacement category --")</option>
                                    </select>
                                    <div id="deleteCategoryError" class="text-danger small mt-2 d-none">@T("Vui lòng chọn danh mục thay thế.", "Please select a replacement category.")</div>
                                </div>
                            </label>
                        </div>
                    </div>

                    <div class="category-subdialog__footer category-delete-subdialog__footer">
                        <button type="button" class="btn btn-outline-secondary" id="btnCancelDeleteChild">@T("Hủy", "Cancel")</button>
                        <button type="button" class="btn btn-danger" id="btnConfirmDeleteCategory">
                            <i class="bx bx-trash me-1"></i>@T("Xóa danh mục", "Delete category")
                        </button>
                    </div>
                </div>
            </div>


<div class="modal-footer category-modal-footer border-top">
                <button type="button" class="btn btn-outline-danger me-auto" id="btnDeleteCategoryStatic">
                    <i class="bx bx-trash me-1"></i>@T("Xóa", "Delete")
                </button>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@T("Đóng", "Close")</button>
                <button type="button" class="btn btn-success" id="btnUpdateCategoryStatic">
                    <i class="bx bx-save me-1"></i>@T("Lưu thay đổi", "Save changes")
                </button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="categoryTypeWarningModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm category-type-warning-dialog">
        <div class="modal-content category-type-warning-card">
            <button type="button" class="btn-close category-type-warning-close" data-bs-dismiss="modal" aria-label="Close"></button>
            <div class="modal-body category-type-warning-body">
                <div class="category-type-warning-icon-wrap">
                    <div class="category-type-warning-icon">
                        <i class="bx bx-error-circle"></i>
                    </div>
                </div>
                <div class="category-type-warning-copy">
                    <div class="category-type-warning-eyebrow">@T("Cảnh báo thay đổi loại", "Type change warning")</div>
                    <h5 class="category-type-warning-title mb-2">@T("Chuyển danh mục sang Thu nhập?", "Switch this category to Income?")</h5>
                    <p class="category-type-warning-text mb-0">@T("Nếu chuyển danh mục này sang Thu nhập, toàn bộ hạn mức hiện có sẽ bị xóa khi bạn lưu thay đổi.", "If you switch this category to Income, all existing budgets will be removed when you save your changes.")</p>
