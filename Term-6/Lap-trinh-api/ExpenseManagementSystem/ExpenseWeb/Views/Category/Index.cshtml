            </div>
            <div class="modal-footer category-type-warning-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@T("Giữ nguyên", "Keep current")</button>
                <button type="button" class="btn btn-warning" id="btnConfirmCategoryTypeIncome">@T("Vẫn chuyển sang Thu nhập", "Switch to Income")</button>
            </div>
        </div>
    </div>
</div>

<div class="toast-container position-fixed bottom-0 start-50 translate-middle-x p-4 category-toast-stack">
    <div id="categorySavedToast" class="toast bg-success text-white" role="alert">
        <div class="toast-header bg-success text-white">
            <i class="icon-base bx bx-check-circle me-2"></i>
